# Local environment variables for the PathForge API.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://pathforge:pathforge_pass@localhost:5433/pathforge_db?schema=public"

# Clerk Auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=whsec_xxx
# Only verified Clerk accounts with one of these emails can manage catalog data.
ADMIN_EMAILS=

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Vector database: choose "pinecone" or "chroma".
VECTOR_DB=pinecone

# Pinecone (required only when VECTOR_DB=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=pathforge-index

# Chroma (required only when VECTOR_DB=chroma)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=pathforge-ai

# Embeddings (OpenAI is currently used for both indexing and question search)
EMBEDDING_MODEL=text-embedding-3-small