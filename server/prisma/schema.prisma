generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  clerkId        String   @unique
  email          String   @unique
  name           String?
  year           Int?     // 1, 2, 3, 4
  branch         String?  // CSE, IT, ECE...
  skills         String[] @default([])
  languages      String[] @default([])
  interests      String[] @default([])
  githubUrl      String?
  leetcodeUrl    String?
  linkedinUrl    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversations  Conversation[]
  roadmaps       Roadmap[]
  savedItems     SavedItem[]
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New Chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // 'user' | 'assistant' | 'system'
  content        String       @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model PlacementExam {
  id                String   @id @default(cuid())
  company           String   @unique
  slug              String   @unique
  logo              String?
  eligibility       String   @db.Text
  examPattern       Json
  difficulty        String   // Easy | Medium | Hard
  topics            String[]
  roadmap           Json
  previousTrends    String   @db.Text
  resources         Json
  expectedSalary    String
  hiringProcess     Json
  tags              String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GovernmentExam {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  category       String   // Higher Ed | Govt | Banking | Railway
  whoShouldTake  String   @db.Text
  eligibility    String   @db.Text
  syllabus       Json
  difficulty     String
  opportunities  String   @db.Text
  officialUrl    String?
  tags           String[]
}

model Technology {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  category      String   // AI, Backend, Frontend, Cloud...
  description   String   @db.Text
  skills        String[]
  languages     String[]
  roadmap       Json
  projects      Json     // { beginner, intermediate, advanced }
  certifications String[]
  salary        String
  companies     String[]
  futureDemand  String
  icon          String?
  color         String?
}

model Language {
  id                String   @id @default(cuid())
  name              String   @unique
  slug              String   @unique
  usedFor           String[]
  companies         String[]
  pros              String[]
  cons              String[]
  beginnerFriendly  Int      // 1-10
  demand            Int      // 1-10
  futureScope       String   @db.Text
  exampleProjects   String[]
  icon              String?
  color             String?
}

model Hackathon {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  type                String   // National | Company | College
  organizer           String
  website             String?
  registrationPeriod  String?
  eligibility         String   @db.Text
  teamSize            String
  mode                String   // Online | Offline | Hybrid
  selectionProcess    String   @db.Text
  problemStatements   String[]
  domains             String[]
  difficulty          String
  previousWinners     String[]
  judgingCriteria     Json
  prizePool           String
  benefits            Json     // internship, PPO, certs
  timeline            Json
  tips                String[]
  tags                String[]
}

model Roadmap {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  goal      String
  content   Json     // structured semester-wise plan
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedItem {
  id         String   @id @default(cuid())
  userId     String
  itemType   String   // exam | tech | language | hackathon
  itemId     String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
}