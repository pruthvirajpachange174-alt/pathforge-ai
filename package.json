{
  "name": "pathforge-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter pathforge-client dev\" \"pnpm --filter pathforge-server dev\"",
    "build": "pnpm --filter pathforge-client build && pnpm --filter pathforge-server build",
    "db:migrate": "pnpm --filter pathforge-server prisma:migrate",
    "db:migrate:deploy": "pnpm --filter pathforge-server prisma:migrate:deploy",
    "db:seed": "pnpm --filter pathforge-server seed",
    "db:studio": "pnpm --filter pathforge-server prisma:studio",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14"
  },
  "packageManager": "pnpm@9.0.0"
}